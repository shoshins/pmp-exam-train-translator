{
    "name": "pmp-exam-tran-translator",
    "version": "0.0.1",
    "description": "Translates PMP Exam Train using Google Translate",
    "main": "src/js/content.js",
    "repository": "https://github.com/shoshins/pmp-exam-train-translater",
    "license": "MIT",
    "devDependencies": {
        "@babel/preset-env": "^7.29.7",
        "babel-loader": "^9.2.1",
        "copy-webpack-plugin": "^12.0.2",
        "rimraf": "^6.0.1",
        "webpack": "^5.99.9",
        "webpack-cli": "^5.1.4"
    },
    "scripts": {
        "start": "nodemon --exec yarn build",
        "prebuild": "rimraf dist",
        "build": "webpack"
    },
    "nodemonConfig": {
        "ignore": [
            "dist/",
            "node_modules"
        ],
        "execMap": {
            "js": "node"
        },
        "ext": "js html css",
        "verbose": true
    },
    "dependencies": {
        "@babel/core": "^7.29.7",
        "nodemon": "^3.1.10"
    },
    "resolutions": {
        "serialize-javascript": "^7.1.4",
        "minimatch": "^11.0.1",
        "glob": "^14.0.2"
    }
}
